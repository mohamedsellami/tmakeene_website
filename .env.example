# Temporary site-wide coming soon page (default: on). Set to false to restore the live site.
# COMING_SOON=false

# Web app URL opened from the home page CTA (default: https://app.tafkira.app)
# NEXT_PUBLIC_WEB_APP_URL=https://app.tafkira.app

# Optional. APK download link for the home page button.
# Default: /downloads/tamkeen.apk — put your file at public/downloads/tamkeen.apk
# NEXT_PUBLIC_APK_URL=https://your-cdn.example.com/tamkeen.apk

# Google Analytics 4 (optional — omit to disable tracking)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WhatsApp link for guardian page CTAs (e.g. https://wa.me/213XXXXXXXXX)
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/213XXXXXXXXX

# Email delivery for guardian registration form (Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# REGISTRATION_TO_EMAIL=tamkeene.app@gmail.com
# REGISTRATION_FROM_EMAIL=Tamkeene <onboarding@resend.dev>

# Supabase (session booking — server-only, never expose service role key to browser)
# Use the SERVICE ROLE key from Supabase → Project Settings → API (NOT the anon/public key)
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
